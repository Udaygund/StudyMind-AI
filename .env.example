NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/studymind

# OpenRouter — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Max output tokens per AI response
OPENROUTER_MAX_TOKENS=4096

# Email sign-in codes (SMTP). Without these, dev mode prints codes to the console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StudyMind <no-reply@yourdomain.com>"
# Random string used to hash sign-in codes (openssl rand -hex 32)
OTP_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
